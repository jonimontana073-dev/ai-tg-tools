{
  "version": 2,
  "builds": [
    { "src": "backend/*.js", "use": "@vercel/node", "config": { "maxDuration": 60 } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/backend/chat.js" },
    { "src": "/api/generate", "dest": "/backend/generate.js" },
    { "src": "/api/telegram-webhook", "dest": "/backend/telegramWebhook.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
